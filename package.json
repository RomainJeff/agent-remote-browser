{
  "name": "agent-remote-browser",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "One sandboxed browser per AI agent, behind a remote MCP gateway",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "smoke": "node test/e2e/smoke.ts",
    "check:compose": "node deploy/check-compose.ts",
    "build:admin": "tsc --noEmit -p src/admin/ui && vite build --config src/admin/ui/vite.config.ts",
    "dev:admin": "vite build --watch --config src/admin/ui/vite.config.ts",
    "pretest": "npm run build:admin"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.28",
    "@better-auth/cimd": "1.7.28",
    "@better-auth/oauth-provider": "1.7.28",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-auth": "1.7.28",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@types/node": "24.19.2",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
