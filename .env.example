# Copy to .env (read by docker compose). Never commit .env.
# Secrets are files, not variables (Docker secrets, see README): ./secrets/login_key and ./secrets/better_auth_secret.

# Prefix of every Docker resource (containers, volumes, images, compose project).
ARB_PREFIX=arb

# Public base URL (https, no trailing slash): Better Auth baseURL (what BETTER_AUTH_URL would be), MCP resource,
# OAuth issuer. Empty = http://localhost:18787 (local dev only). Required when NODE_ENV=production.
PUBLIC_URL=

# 1 = also serve the admin UI on the public listener (behind PUBLIC_URL). Default: localhost:18788 only.
ADMIN_PUBLIC=
# Cloudflare Access in front of the public admin: application AUD tag (64 hex) and team name. Both or neither.
ACCESS_AUD=
ACCESS_TEAM=

# Minutes before an idle browser container is stopped.
IDLE_MIN=5

# Container runtime for the browsers: runsc (gVisor). The gateway refuses to start without it...
SANDBOX_RUNTIME=
# ...unless this is 1 (dev on macOS, where gVisor is not available). Never 1 in production.
ALLOW_NO_SANDBOX=

# Group id owning /var/run/docker.sock as seen inside the gateway. Docker Desktop: 0. Linux: `getent group docker`.
DOCKER_GID=0
