# Copy to .env (read by docker compose). Never commit .env.
# Secrets are files, not variables (Docker secrets, see deploy/runbook.md): ./secrets/login_key,
# ./secrets/better_auth_secret and, with compose.tunnel.yaml, ./secrets/cloudflared_token.

# With the Cloudflare tunnel, uncomment (deploy/runbook.md, section 3). Never leave it set but empty.
# COMPOSE_FILE=compose.yaml:compose.tunnel.yaml

# Prefix of every Docker resource (containers, volumes, images, compose project).
ARB_PREFIX=arb

# Host address the MCP port (18787) is published on, compose.yaml only (compose.tunnel.yaml publishes nothing).
# Default 127.0.0.1. The admin port (18788) stays on 127.0.0.1 whatever this is.
BIND_ADDR=

# Public base URL (https, no trailing slash): Better Auth baseURL (what BETTER_AUTH_URL would be), MCP resource,
# OAuth issuer. Empty = http://localhost:18787 (local dev only). Required when NODE_ENV=production.
PUBLIC_URL=

# 1 = also serve the admin UI on the public listener (behind PUBLIC_URL). Default: localhost:18788 only.
# Requires ACCESS_AUD and ACCESS_TEAM: the gateway refuses to start without Cloudflare Access in front.
ADMIN_PUBLIC=
# Cloudflare Access in front of the public admin: application AUD tag (64 hex) and team name. Both or neither.
ACCESS_AUD=
ACCESS_TEAM=

# Minutes before an idle browser container is stopped.
IDLE_MIN=5
# Browser containers running at once, at most (~1 GB RAM each). Default 4.
MAX_COMPUTERS=

# TRUST_PROXY is not set here: compose.tunnel.yaml sets it to cloudflare, where the gateway has no published port.
# With a published port, any client could choose its Cf-Connecting-IP (the rate limit key).

# Container runtime for the browsers: runsc (gVisor). The runner refuses to start without it...
SANDBOX_RUNTIME=
# ...unless this is 1 (dev on macOS, where gVisor is not available). Never 1 in production.
ALLOW_NO_SANDBOX=

# Group id owning /var/run/docker.sock as seen inside the runner (the only service with the socket). Docker Desktop: 0. Linux: `getent group docker`.
DOCKER_GID=0
