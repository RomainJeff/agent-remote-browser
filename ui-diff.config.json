{
  "buildCommand": "npm run build:admin",
  "startCommand": "node test/ui-preview.ts",
  "readyPath": "/?signed-in",
  "detect": { "maxRoutes": 16 },
  "routes": [
    { "path": "/", "files": ["src/admin/ui/**"] },
    { "path": "/?signed-in#/profiles", "files": ["src/admin/ui/**"] },
    { "path": "/?signed-in#/profiles/shop", "files": ["src/admin/ui/**"] },
    { "path": "/?signed-in#/profiles/shop", "name": "profile-logins", "actions": [{ "click": "role=link[name=/^Logins/]" }], "files": ["src/admin/ui/**"] },
    { "path": "/?signed-in#/profiles/shop", "name": "profile-playbooks", "actions": [{ "click": "role=link[name=/^Playbooks/]" }], "files": ["src/admin/ui/**"] },
    { "path": "/?signed-in#/profiles/shop", "name": "profile-domains", "actions": [{ "click": "role=link[name=/^Domains/]" }], "files": ["src/admin/ui/**"] },
    { "path": "/?signed-in#/profiles/shop", "name": "profile-diagnostics", "actions": [{ "click": "role=link[name=/^Diagnostics/]" }], "files": ["src/admin/ui/**"] },
    { "path": "/?signed-in#/profiles/shop", "name": "profile-sharing", "actions": [{ "click": "role=link[name=/^Sharing/]" }], "files": ["src/admin/ui/**"] },
    { "path": "/?signed-in#/profiles/shop", "name": "profile-settings", "actions": [{ "click": "role=link[name=/^Settings/]" }], "files": ["src/admin/ui/**"] },
    { "path": "/?signed-in#/members", "files": ["src/admin/ui/**"] },
    { "path": "/?signed-in#/access", "files": ["src/admin/ui/**"] },
    { "path": "/?signed-in#/security", "files": ["src/admin/ui/**"] },
    { "path": "/#/reset-password/preview", "files": ["src/admin/ui/**"] }
  ]
}
