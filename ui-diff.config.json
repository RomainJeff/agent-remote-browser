{
  "buildCommand": "npm run build:admin",
  "startCommand": "node test/ui-preview.ts",
  "readyPath": "/?signed-in",
  "env": {
    "EGRESS_DIR": ".ui-diff/egress"
  },
  "detect": {
    "maxRoutes": 16,
    "conventions": false
  },
  "routes": [
    {
      "path": "/",
      "files": [
        "src/admin/ui/**"
      ]
    },
    {
      "path": "/?signed-in#/profiles",
      "files": [
        "src/admin/ui/**"
      ]
    },
    {
      "path": "/?signed-in#/profiles/shop",
      "files": [
        "src/admin/ui/**"
      ]
    },
    {
      "path": "/?signed-in#/profiles/shop?capture=logins",
      "name": "profile-logins",
      "actions": [
        {
          "click": "role=link[name=/^Logins/]"
        }
      ],
      "files": [
        "src/admin/ui/**"
      ]
    },
    {
      "path": "/?signed-in#/profiles/shop?capture=playbooks",
      "name": "profile-playbooks",
      "actions": [
        {
          "click": "role=link[name=/^Playbooks/]"
        }
      ],
      "files": [
        "src/admin/ui/**"
      ]
    },
    {
      "path": "/?signed-in#/profiles/shop?capture=domains",
      "name": "profile-domains",
      "actions": [
        {
          "click": "role=link[name=/^Domains/]"
        }
      ],
      "files": [
        "src/admin/ui/**"
      ]
    },
    {
      "path": "/?signed-in#/profiles/shop?capture=diagnostics",
      "name": "profile-diagnostics",
      "actions": [
        {
          "click": "role=link[name=/^Diagnostics/]"
        }
      ],
      "files": [
        "src/admin/ui/**"
      ]
    },
    {
      "path": "/?signed-in#/profiles/shop?capture=sharing",
      "name": "profile-sharing",
      "actions": [
        {
          "click": "role=link[name=/^Sharing/]"
        }
      ],
      "files": [
        "src/admin/ui/**"
      ]
    },
    {
      "path": "/?signed-in#/profiles/shop?capture=settings",
      "name": "profile-settings",
      "actions": [
        {
          "click": "role=link[name=/^Settings/]"
        }
      ],
      "files": [
        "src/admin/ui/**"
      ]
    },
    {
      "path": "/?signed-in#/members",
      "files": [
        "src/admin/ui/**"
      ]
    },
    {
      "path": "/?signed-in#/access",
      "files": [
        "src/admin/ui/**"
      ]
    },
    {
      "path": "/?signed-in#/security",
      "files": [
        "src/admin/ui/**"
      ]
    },
    {
      "path": "/#/reset-password/preview",
      "files": [
        "src/admin/ui/**"
      ]
    },
    {
      "path": "/#/invite/preview",
      "files": [
        "src/admin/ui/**"
      ]
    }
  ],
  "flows": [
    {
      "name": "account sheet",
      "route": "/?signed-in#/profiles",
      "viewports": [
        "mobile"
      ],
      "steps": [
        {
          "click": "button[aria-label='Account']"
        },
        {
          "wait": "[role=dialog]",
          "checkpoint": "open"
        }
      ]
    },
    {
      "name": "record output",
      "route": "/?signed-in#/profiles/shop",
      "steps": [
        {
          "click": "role=button[name='Record playbook']"
        },
        {
          "click": "role=button[name=/^Add output/]"
        },
        {
          "wait": "[role=menu]",
          "checkpoint": "menu"
        },
        {
          "click": "role=menuitem[name=/^Page snapshot/]"
        },
        {
          "wait": "text=Snapshot of the page",
          "checkpoint": "snapshot"
        },
        {
          "click": "role=button[name='Limit to an area']"
        },
        {
          "wait": "text=Picking an area",
          "checkpoint": "area pick"
        }
      ]
    }
  ]
}
