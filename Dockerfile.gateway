# Gateway image: MCP server + docker CLI. Drives the host daemon through the mounted socket.
FROM node:22-bookworm-slim
COPY --from=docker:29.0.4-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY *.mjs admin.html ./
RUN node check.mjs
EXPOSE 8787 8788
CMD ["node", "gateway.mjs"]
