# Gateway image: MCP server + docker CLI. Drives the host daemon through the mounted socket.
FROM node:26-bookworm-slim
COPY --from=docker:29.0.4-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY *.mjs admin.html ./
COPY src ./src
# Test suite runs at build time (fake docker, no daemon needed); test/ is bind-mounted, never shipped.
RUN --mount=type=bind,source=test,target=/app/test node --test "test/**/*.test.ts"
EXPOSE 8787 8788
CMD ["node", "gateway.mjs"]
