{
  // Node runs the .ts files directly (type stripping): tsc only type-checks.
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "deploy/**/*.ts"],
  // The admin UI is bundled by Vite and checked with its own tsconfig (DOM, JSX).
  "exclude": ["src/admin/ui"]
}
